# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL / Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intakeo_forms

# Security & CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Postgres — your database connection
DATABASE_URL_POOLED=""

# Neon Managed Better Auth — sign-in for your app
NEON_AUTH_BASE_URL=""
