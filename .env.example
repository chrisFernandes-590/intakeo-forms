# Node Environment
NODE_ENV=development

# Postgres Database URL (Postgres 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/formflow

# Redis URL (Redis 7)
REDIS_URL=redis://localhost:6379

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=app-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Mailpit SMTP
SMTP_HOST=localhost
SMTP_PORT=1025

# Session Secret (min 32 characters)
SESSION_SECRET=dev_session_secret_change_in_production_min_32_chars
